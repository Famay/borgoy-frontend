# VerMeat environment example.
# Copy this file to .env and replace values for your machine or server.

# Database
POSTGRES_DB=vermeat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vermeat?schema=public

# API auth
JWT_SECRET=change-me-before-production
JWT_EXPIRES_IN=7d
SERVER_PORT=4000

# Local frontend/API
CLIENT_ORIGIN=http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:4000/api

# Docker local/prod
API_PORT=4000
WEB_PORT=80
DOCKER_CLIENT_ORIGIN=http://localhost
DOCKER_PUBLIC_APP_URL=http://localhost
DOCKER_VITE_API_URL=/api

# Production domain and TLS
# For first certbot run use ./nginx/templates/http.conf.template.
# After certificate issue use ./nginx/templates/ssl.conf.template.
SERVER_NAME=vermeat.ru www.vermeat.ru
CERTBOT_DOMAIN=vermeat.ru
LETSENCRYPT_EMAIL=admin@example.com
NGINX_TEMPLATE=./nginx/templates/http.conf.template

# Email 2FA
# Use file for local testing, smtp for Maileroo, resend for Resend.
TWO_FACTOR_EMAIL_PROVIDER=smtp
RESEND_API_KEY=
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VerMeat <vermeat@3364dce0ebf8729b.maileroo.org>"

# Pinata/IPFS
PINATA_JWT=
PINATA_GATEWAY=

# Polygon Amoy
POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_PRIVATE_KEY=
CERTIFICATE_CONTRACT_ADDRESS=
